# Copy to .env and paste your key after the "=" (no quotes, no spaces).
GROQ_API_KEY=

# Optional: extra free-tier keys from other Groq orgs. The client rotates to the next key when one
# hits its per-day token cap, so the daily budget scales with the number of keys (~200k tokens each).
# Either number them:
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# GROQ_API_KEY_4=
# GROQ_API_KEY_5=
# ...or list them all on one line (comma- or space-separated):
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3,gsk_key4,gsk_key5

# Optional overrides
# AGENTGUARD_LLM_MODE=auto         # auto | off | record | replay
# AGENTGUARD_CACHE_DIR=cache/llm
# AGENTGUARD_RUNS_DIR=runs
