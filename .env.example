# Groq API keys (one per Groq account/organization; the daily token limit is per organization)
GROQ_API_KEY_1=
GROQ_API_KEY_2=

# Security alerts (optional). Leave blank to keep alerts in dry-run mode (nothing is sent).
# SMTP_APP_PASSWORD is a Google *app password* (Google Account > Security > 2-Step Verification > App passwords),
# NOT your normal Gmail password.
SECURITY_ALERT_EMAIL=
SMTP_USER=
SMTP_APP_PASSWORD=
